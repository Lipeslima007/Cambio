<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ConversorMoedaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título em duas linhas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Conversor\nde Moedas"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Cartão com borda: bandeira origem | botão inverter | bandeira destino -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/borda"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivBandeiraOrigem"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="Bandeira da moeda de origem"
                android:scaleType="fitCenter"
                android:src="@drawable/bandeira_br" />

            <Button
                android:id="@+id/btnInverter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="⇄"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/ivBandeiraDestino"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="Bandeira da moeda de destino"
                android:scaleType="fitCenter"
                android:src="@drawable/bandeira_eua" />
        </LinearLayout>

        <!-- Escolha da moeda estrangeira -->
        <RadioGroup
            android:id="@+id/rgMoeda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDolar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Dólar (US$)" />

            <RadioButton
                android:id="@+id/rbEuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Euro (€)" />
        </RadioGroup>

        <!-- textColor fixo: o fundo é branco, então o texto precisa ser escuro (senão some no modo noturno) -->
        <EditText
            android:id="@+id/etValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/borda_campo"
            android:hint="Digite o valor"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <!-- Botões Calcular e Limpar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Calcular" />

            <Button
                android:id="@+id/btnLimpar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Limpar" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Resultado: US$ 0,00"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>